<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ex-Servicemen Job Scraper</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

        .header {
            background: linear-gradient(135deg, #2c3e50, #34495e);
            color: white;
            padding: 30px;
            text-align: center;
        }

        .header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }

        .header p {
            font-size: 1.2em;
            opacity: 0.9;
        }

        .controls {
            padding: 30px;
            background: #f8f9fa;
            border-bottom: 1px solid #e9ecef;
        }

        .input-group {
            margin-bottom: 20px;
        }

        .input-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #2c3e50;
        }

        .input-group input {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e9ecef;
            border-radius: 10px;
            font-size: 16px;
            transition: all 0.3s ease;
        }

        .input-group input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .btn {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            border: none;
            padding: 15px 30px;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-right: 10px;
        }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
        }

        .btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        .loading {
            display: none;
            text-align: center;
            padding: 20px;
            color: #667eea;
            font-size: 18px;
        }

        .spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #667eea;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-right: 10px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .results {
            padding: 30px;
            max-height: 600px;
            overflow-y: auto;
        }

        .job-card {
            background: white;
            border: 1px solid #e9ecef;
            border-radius: 15px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .job-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
        }

        .job-title {
            font-size: 1.4em;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 10px;
            line-height: 1.3;
        }

        .job-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
            margin-bottom: 15px;
        }

        .meta-item {
            background: #f8f9fa;
            padding: 8px 12px;
            border-radius: 8px;
            font-size: 0.9em;
            color: #495057;
        }

        .meta-label {
            font-weight: 600;
            color: #667eea;
        }

        .job-description {
            color: #6c757d;
            line-height: 1.6;
            margin-bottom: 15px;
        }

        .job-links {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .link-btn {
            background: linear-gradient(135deg, #28a745, #20c997);
            color: white;
            text-decoration: none;
            padding: 8px 16px;
            border-radius: 8px;
            font-size: 0.9em;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .link-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 10px rgba(40, 167, 69, 0.3);
        }

        .json-output {
            background: #2c3e50;
            color: #ecf0f1;
            padding: 20px;
            border-radius: 10px;
            font-family: 'Courier New', monospace;
            font-size: 14px;
            line-height: 1.6;
            white-space: pre-wrap;
            max-height: 400px;
            overflow-y: auto;
            margin-top: 20px;
        }

        .stats {
            background: linear-gradient(135deg, #17a2b8, #138496);
            color: white;
            padding: 20px;
            text-align: center;
            font-size: 1.2em;
            font-weight: 600;
        }

        .error {
            background: #f8d7da;
            color: #721c24;
            padding: 15px;
            border-radius: 10px;
            margin: 20px 0;
            border-left: 4px solid #dc3545;
        }

        @media (max-width: 768px) {
            .container {
                margin: 10px;
                border-radius: 15px;
            }
            
            .header h1 {
                font-size: 2em;
            }
            
            .job-meta {
                flex-direction: column;
                gap: 10px;
            }
            
            .job-links {
                flex-direction: column;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>🎖️ Ex-Servicemen Job Scraper</h1>
            <p>Find Civilian Jobs for Retired Army Personnel</p>
        </div>

        <div class="controls">
            <div class="input-group">
                <label for="websiteUrl">Website URL to Scrape:</label>
                <input type="url" id="websiteUrl" value="https://20govt.com/jobs-for/ex-servicemen-vacancy/" placeholder="Enter website URL...">
            </div>
            
            <div class="input-group">
                <label for="maxJobs">Maximum Jobs to Scrape:</label>
                <input type="number" id="maxJobs" value="50" min="1" max="100" placeholder="Enter number of jobs...">
            </div>

            <button class="btn" onclick="scrapeJobs()">🔍 Start Scraping</button>
            <button class="btn" onclick="exportJSON()" id="exportBtn" style="display: none;">📥 Export JSON</button>
            <button class="btn" onclick="clearResults()">🗑️ Clear Results</button>
        </div>

        <div class="loading" id="loading">
            <div class="spinner"></div>
            Scraping job postings... Please wait...
        </div>

        <div id="results" class="results"></div>
    </div>

    <script>
        let scrapedJobs = [];

        async function scrapeJobs() {
            const url = document.getElementById('websiteUrl').value;
            const maxJobs = parseInt(document.getElementById('maxJobs').value) || 50;
            
            if (!url) {
                showError('Please enter a valid website URL');
                return;
            }

            showLoading(true);
            clearResults();

            try {
                // Simulate job scraping with mock data based on the website structure
                const jobs = await simulateJobScraping(url, maxJobs);
                displayJobs(jobs);
                scrapedJobs = jobs;
                
                if (jobs.length > 0) {
                    document.getElementById('exportBtn').style.display = 'inline-block';
                }
                
                showStats(jobs.length);
            } catch (error) {
                showError('Error scraping jobs: ' + error.message);
            }

            showLoading(false);
        }

        async function simulateJobScraping(url, maxJobs) {
            // Simulate network delay
            await new Promise(resolve => setTimeout(resolve, 2000));
            
            // Mock job data based on the actual website structure
            const mockJobs = [
                {
                    title: "BEL Driver Recruitment 2025",
